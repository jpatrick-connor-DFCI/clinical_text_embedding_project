# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Log files
*.err
*.out
bash_scripts/error/
bash_scripts/output/

# Python
__pycache__/
*.pyc
*.pyo
.env
*.egg-info/
build/
dist/

# macOS
.DS_Store

# Data files (if applicable)
*.csv
*.parquet
*.tsv
data/

# The top-level data/ package holds versioned code and the curated
# biomarker-validation table, not generated project data. The leading slash
# anchors these to the repo root, so a data/ directory anywhere else stays
# ignored by the rule above.
!/data/
!/data/**
# ...but the negation above out-ranks the earlier Python rules (last match wins),
# so re-exclude build artifacts inside it.
/data/**/__pycache__/
/data/**/*.pyc
